    <worksheet name='Attrition by Age'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Attrition rate by age</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Employee+' name='federated.18sa7vm1s624h012dex7n0nw0s02' />
          </datasources>
          <datasource-dependencies datasource='federated.18sa7vm1s624h012dex7n0nw0s02'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Total Employees' datatype='integer' name='[Calculation_0311216048836608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([EmployeeID])' />
            </column>
            <column caption='Past Employees' datatype='integer' name='[Calculation_0311216056848386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Attrition] = &apos;Yes&apos; THEN [EmployeeID] END)' />
            </column>
            <column caption='Attrition rate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0311216063778820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0311216056848386]/[Calculation_0311216048836608])*100' />
            </column>
            <column caption='Age_group' datatype='string' name='[Calculation_0901655642308608]' role='dimension' type='nominal'>
