    <worksheet name='Employee Ratings'>
      <table>
        <view>
          <datasources>
            <datasource caption='Employee+' name='federated.18sa7vm1s624h012dex7n0nw0s02' />
          </datasources>
          <datasource-dependencies datasource='federated.18sa7vm1s624h012dex7n0nw0s02'>
            <column caption='Full Name' datatype='string' name='[Calculation_0901655653756932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[FirstName]+&quot; &quot;+[LastName]' />
            </column>
            <column caption='Latest Review Date' datatype='date' name='[Calculation_0901655656382469]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_0901655653756932] : MAX([ReviewDate])}' />
            </column>
            <column caption='Latest Manager Rating' datatype='integer' name='[Calculation_0901655669592072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0901655656382469] = [ReviewDate] THEN [ManagerRatingID]&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Latest Self Rating' datatype='integer' name='[Calculation_0901655671836681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0901655656382469] = [ReviewDate] THEN [SelfRatingID]&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Difference in Rating' datatype='integer' name='[Calculation_0901655675027466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0901655669592072]-[Calculation_0901655671836681]' />
            </column>
            <column caption='First Name' datatype='string' name='[FirstName]' role='dimension' type='nominal' />
            <column caption='Hire Date' datatype='date' name='[HireDate]' role='dimension' type='ordinal' />
            <column caption='Last Name' datatype='string' name='[LastName]' role='dimension' type='nominal' />
            <column caption='Manager Rating ID' datatype='integer' name='[ManagerRatingID]' role='dimension' type='ordinal' />
            <column caption='Review Date' datatype='date' name='[ReviewDate]' role='dimension' type='ordinal' />
            <column caption='Self Rating ID' datatype='integer' name='[SelfRatingID]' role='dimension' type='ordinal' />
            <column caption='Years At Company' datatype='integer' name='[YearsAtCompany]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0901655653756932]' derivation='None' name='[none:Calculation_0901655653756932:nk]' pivot='key' type='nominal' />
